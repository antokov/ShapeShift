# DB_PATH: relative path from backend/ directory to the SQLite database file
# Default: data/fitnessapp.db
DB_PATH=data/fitnessapp.db

# Note: if you have an existing fitnessapp.db in the backend/ root (from an older setup),
# move it: mv backend/fitnessapp.db backend/data/fitnessapp.db

# Garmin Connect credentials (optional — only needed for Garmin view)
# Tokens are cached in data/garmin_tokens/ after first successful login.
# Restart the backend after adding these values.
GARMIN_EMAIL=your@email.com
GARMIN_PASSWORD=yourpassword

# Anthropic API key (optional — only needed for "Mein Coach" feature)
# Get your key at https://console.anthropic.com
ANTHROPIC_API_KEY=your_anthropic_api_key_here

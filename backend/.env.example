# DB_PATH: relative path from backend/ directory to the SQLite database file
# Default: data/fitnessapp.db
# Only used when DATABASE_URL is NOT set (see below).
DB_PATH=data/fitnessapp.db

# Note: if you have an existing fitnessapp.db in the backend/ root (from an older setup),
# move it: mv backend/fitnessapp.db backend/data/fitnessapp.db

# DATABASE_URL: when set, the backend uses Postgres instead of SQLite.
# Leave unset for local dev (SQLite via DB_PATH above). Set this in Coolify
# for production, pointing at a managed Postgres instance.
# Format: postgresql://user:password@host:5432/dbname
# DATABASE_URL=postgresql://user:password@host:5432/fitnessapp

# CORS_ORIGINS: comma-separated allowlist, only needed if frontend and
# backend are deployed on different domains (e.g. separate Coolify apps).
# CORS_ORIGINS=https://shapeshift.kovacevic.xyz

# Garmin Connect credentials (optional — only needed for Garmin view)
# Tokens are cached in data/garmin_tokens/ after first successful login.
# Restart the backend after adding these values.
GARMIN_EMAIL=your@email.com
GARMIN_PASSWORD=yourpassword

# Anthropic API key (optional — only needed for "Mein Coach" feature)
# Get your key at https://console.anthropic.com
ANTHROPIC_API_KEY=your_anthropic_api_key_here
